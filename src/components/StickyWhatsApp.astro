<style>
  .sticky-wa-button {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background-color: #F47C20;
    color: #0B2545;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.15rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(244, 124, 32, 0.4);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    z-index: 100;
    transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .sticky-wa-button:hover {
    background-color: #e06912;
    color: #0B2545;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(244, 124, 32, 0.5);
  }
  .wa-icon {
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .sticky-wa-button {
      bottom: 1rem;
      right: 1rem;
      padding: 0.65rem 0.95rem;
      font-size: 0.85rem;
    }
    .wa-text {
      display: inline-block;
    }
  }
</style>
