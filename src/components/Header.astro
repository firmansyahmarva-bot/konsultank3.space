---
import { SITE_INFO } from '../config';

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/biaya-konsultan-k3/', label: 'Biaya Konsultan' },
  { href: '/audit-smk3/', label: 'Audit SMK3' },
  { href: '/dokumen-smk3/', label: 'Dokumen SMK3' },
  { href: '/smkk-konstruksi/', label: 'SMKK Konstruksi' },
  { href: '/konsultasi-gratis/', label: 'Konsultasi Gratis', isCta: true }
];
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="brand-link" aria-label={SITE_INFO.name}>
      <span class="brand-mark" aria-hidden="true">K3</span>
      <span class="brand-name">Konsultan<span>K3</span></span>
    </a>
    <nav class="main-nav" aria-label="Navigasi Utama">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class="nav-item">
            <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined} class:list={['nav-link', { 'nav-cta': link.isCta }]}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: #102b3d;
    color: #ffffff;
    border-bottom: 1px solid #dcfdf238;
    box-shadow: 0 6px 24px #102b3d1c;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  @supports (backdrop-filter: blur(16px)) {
    .site-header {
      background-color: #102b3dec;
      backdrop-filter: saturate(135%) blur(16px);
    }
  }
  .header-container {
    max-width: 1232px;
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand-link {
    text-decoration: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: .65rem;
    flex-shrink: 0;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .65rem;
    background: #91e7d2;
    color: var(--color-ink);
    font-size: .85rem;
    font-weight: 850;
  }
  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  .brand-name span { color: #91e7d2; }
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: .35rem;
    flex-wrap: wrap;
  }
  .nav-item { margin: 0; }
  .nav-link {
    display: block;
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    padding: 0.4rem 0.65rem;
    border-radius: .55rem;
  }
  .nav-link:hover, .nav-link[aria-current="page"] {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }
  .nav-cta {
    background-color: var(--color-amber);
    color: var(--color-ink);
    font-weight: 700;
    padding: 0.45rem 0.9rem;
  }
  .nav-cta:hover, .nav-cta[aria-current="page"] {
    background-color: #ffd3a1;
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-link { transition: background-color .2s, color .2s; }
  }
  @media (max-width: 900px) {
    .header-container {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
      padding: 0.75rem 1rem;
    }
    .main-nav {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .nav-list {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding: .25rem;
      white-space: nowrap;
    }
    .nav-link {
      font-size: 0.85rem;
      padding: 0.35rem 0.6rem;
      flex-shrink: 0;
    }
  }
</style>
