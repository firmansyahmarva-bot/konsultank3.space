---
import { SITE_INFO, CONTACT_INFO, COMPANY_INFO } from '../config';

const pillarLinks = [
  { href: '/biaya-konsultan-k3/', label: 'Biaya Jasa Konsultan K3' },
  { href: '/audit-smk3/', label: 'Persiapan Audit SMK3' },
  { href: '/syarat-sertifikasi-smk3/', label: 'Syarat Sertifikat SMK3 PP 50/2012' },
  { href: '/kriteria-audit-smk3/', label: '166 Kriteria Audit SMK3' },
  { href: '/dokumen-smk3/', label: 'Daftar Dokumen SMK3 Wajib' },
  { href: '/membentuk-p2k3/', label: 'Tata Cara Membentuk P2K3' },
  { href: '/laporan-p2k3-disnaker/', label: 'Laporan P2K3 ke Disnaker' },
  { href: '/smkk-konstruksi/', label: 'SMKK Konstruksi Kontraktor' },
  { href: '/panduan-csms-kontraktor/', label: 'Panduan CSMS Kontraktor' },
  { href: '/sanksi-tidak-menerapkan-k3/', label: 'Sanksi Tidak Menerapkan K3' }
];

const technicalLinks = [
  { href: '/contoh-hiradc/', label: 'Contoh HIRADC & Matriks Risiko' },
  { href: '/hierarki-pengendalian-risiko/', label: '5 Hierarki Pengendalian Risiko' },
  { href: '/sio-dan-sia-k3/', label: 'Panduan Lisensi SIO & SIA K3' },
  { href: '/izin-kerja-k3-ptw/', label: 'Sistem Izin Kerja Aman (PTW)' },
  { href: '/investigasi-kecelakaan-kerja/', label: 'Investigasi Kecelakaan Kerja' },
  { href: '/jenis-apd-k3/', label: 'Ensiklopedia 8 Jenis APD K3' },
  { href: '/arti-rambu-k3/', label: 'Arti Rambu K3 & Simbol B3' },
  { href: '/isi-kotak-p3k-permenaker/', label: 'Daftar Isi Kotak P3K Standar' }
];
---

<footer class="site-footer">
  <section class="footer-consult" aria-labelledby="footer-consult-heading">
    <div>
      <h2 id="footer-consult-heading">Siap membahas kebutuhan K3 Anda?</h2>
      <p>Diskusikan persiapan audit SMK3, dokumen K3, atau kebutuhan tender bersama tim kami.</p>
    </div>
    <div class="footer-actions">
      <a href="/konsultasi-gratis/#form-konsultasi" class="footer-btn">Konsultasi Gratis <span aria-hidden="true">↗</span></a>
      <a href={CONTACT_INFO.whatsappUrl} class="footer-chat">Chat WhatsApp</a>
    </div>
  </section>

  <div class="footer-container">
    <div class="footer-company">
      <a href="/" class="footer-brand"><span class="footer-mark" aria-hidden="true">K3</span>{SITE_INFO.name}</a>
      <div class="company-identity">
        <strong>{COMPANY_INFO.legalName}</strong>
        <address>{COMPANY_INFO.address}</address>
        <a href={CONTACT_INFO.whatsappUrl} class="footer-number">{CONTACT_INFO.whatsappNumber}</a>
      </div>
    </div>

    <nav aria-labelledby="footer-regulation">
      <h2 class="footer-title" id="footer-regulation">Regulasi &amp; Audit</h2>
      <ul class="footer-links">
        {pillarLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-technical">
      <h2 class="footer-title" id="footer-technical">Panduan Teknis K3</h2>
      <ul class="footer-links">
        {technicalLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="disclaimer-container">
    <div class="disclaimer-inner">
      <div class="copyright-text">
        &copy; {new Date().getFullYear()} {COMPANY_INFO.legalName} ({SITE_INFO.name}). Hak cipta dilindungi undang-undang.
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-top: clamp(1.25rem, 4vw, 3.25rem);
    background: radial-gradient(ellipse at 85% 0%, #184e4c, transparent 48%), #0c2233;
    color: #e2edf0;
  }

  .footer-consult, .footer-container, .disclaimer-inner {
    width: min(100% - 2.5rem, 1192px);
    margin-inline: auto;
  }

  .footer-consult {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2.75rem);
    border: 1px solid #a8ebdb50;
    border-radius: 1.4rem;
    background: linear-gradient(115deg, #2b596365, #34795e4d);
    box-shadow: inset 0 1px 0 #dcfff42a;
  }

  .footer-consult h2 {
    margin: 0 0 .6rem;
    padding: 0;
    border: 0;
    color: #fff;
    font-size: clamp(1.65rem, 3.5vw, 2.75rem);
    letter-spacing: -.04em;
    line-height: 1.12;
  }

  .footer-consult p { margin: 0; color: #d9eeea; max-width: 52ch; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
  .footer-btn, .footer-chat {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    padding: .7rem 1rem;
    border: 1px solid transparent;
    border-radius: .7rem;
    font-weight: 750;
    text-decoration: none;
  }

  .footer-btn { background: var(--color-amber); color: var(--color-ink); }
  .footer-btn:hover { background: #ffd3a1; color: var(--color-ink); }
  .footer-chat { border-color: #a8ebdb75; background: #071c2e44; color: #fff; }
  .footer-chat:hover { background: #ffffff23; color: #fff; }

  .footer-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(2, minmax(0, .9fr));
    gap: clamp(1rem, 5vw, 4rem);
    padding-block: clamp(2rem, 5vw, 3.8rem);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1rem;
    color: #fff;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-brand:hover, .footer-title { color: #a8ebdb; }
  .footer-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .65rem;
    background: #91e7d2;
    color: var(--color-ink);
    font-size: .85rem;
  }

  .company-identity {
    display: grid;
    gap: .55rem;
    max-width: 30ch;
    color: #c8dce2;
    font-size: .92rem;
  }

  .company-identity address { font-style: normal; }
  .footer-number {
    justify-self: start;
    color: #a8ebdb;
    font-weight: 700;
    text-underline-offset: .2em;
  }
  .footer-number:hover, .footer-link:hover { color: #fff; }
  .footer-title {
    margin: 0 0 .8rem;
    padding: 0;
    border: 0;
    font-size: 1rem;
  }

  .footer-links { list-style: none; margin: 0; padding: 0; }
  .footer-links li { margin: 0; }
  .footer-link {
    display: block;
    width: fit-content;
    padding: .25rem 0;
    color: #c8dce2;
    font-size: .91rem;
    text-decoration: none;
  }

  .footer-link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .site-footer a:focus-visible { outline-color: var(--color-amber); }
  .disclaimer-container { border-top: 1px solid #d8fff227; background: #081b2a; }
  .disclaimer-inner { padding-block: 1.25rem; }
  .copyright-text { color: #b8cbd2; font-size: .83rem; }

  @media (prefers-reduced-motion: no-preference) {
    .footer-btn, .footer-chat { transition: background-color .2s, transform .2s; }
    .footer-btn:hover, .footer-chat:hover { transform: translateY(-2px); }
  }

  @media (max-width: 760px) {
    .footer-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-company { grid-column: 1 / -1; }
  }
</style>
