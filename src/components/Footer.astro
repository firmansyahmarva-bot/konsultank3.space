---
import { SITE_INFO, CONTACT_INFO, COMPANY_INFO } from '../config';

const pillarLinks = [
  { href: '/biaya-konsultan-k3/', label: 'Biaya Jasa Konsultan K3' },
  { href: '/audit-smk3/', label: 'Persiapan Audit SMK3' },
  { href: '/syarat-sertifikasi-smk3/', label: 'Syarat Sertifikat SMK3 PP 50/2012' },
  { href: '/dokumen-smk3/', label: 'Daftar Dokumen SMK3 Wajib' },
  { href: '/membentuk-p2k3/', label: 'Tata Cara Membentuk P2K3' },
  { href: '/smkk-konstruksi/', label: 'SMKK Konstruksi Kontraktor' },
  { href: '/contoh-hiradc/', label: 'Contoh HIRADC & Matriks Risiko' },
  { href: '/sanksi-tidak-menerapkan-k3/', label: 'Sanksi Tidak Menerapkan K3' },
  { href: '/konsultasi-gratis/', label: 'Konsultasi K3 Gratis' },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col about-col">
      <h3 class="footer-title">{SITE_INFO.name}</h3>
      <div class="footer-summary">
        Konsultasi K3 dan pendampingan regulasi keselamatan kerja di Indonesia.
      </div>
      <div class="company-identity">
        <div class="identity-item"><strong>Badan Hukum:</strong> {COMPANY_INFO.legalName}</div>
        <div class="identity-item"><strong>Alamat:</strong> {COMPANY_INFO.address}</div>
        <div class="identity-item"><strong>WhatsApp:</strong> <a href={CONTACT_INFO.whatsappUrl} class="footer-link">{CONTACT_INFO.whatsappNumber}</a></div>
      </div>
    </div>

    <div class="footer-col links-col">
      <h3 class="footer-title">Panduan Regulasi K3</h3>
      <ul class="footer-links">
        {pillarLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col contact-col">
      <h3 class="footer-title">Layanan Asistensi</h3>
      <div class="contact-item">
        <strong>WhatsApp:</strong><br />
        <a href={CONTACT_INFO.whatsappUrl} class="footer-link">{CONTACT_INFO.whatsappNumber}</a>
      </div>
      <div class="contact-item">
        <strong>Jam Operasional:</strong><br />
        Senin – Jumat: 08.30 – 17.00 WIB
      </div>
      <div class="footer-cta-box">
        <a href="/konsultasi-gratis/" class="footer-btn">Ajukan Konsultasi K3</a>
      </div>
    </div>
  </div>

  <div class="disclaimer-container">
    <div class="disclaimer-inner">
      <div class="copyright-text">
        &copy; {new Date().getFullYear()} {COMPANY_INFO.legalName} ({SITE_INFO.name}). Hak cipta dilindungi undang-undang.
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0B2545;
    color: #e2e8f0;
    margin-top: 4rem;
    border-top: 4px solid #F47C20;
    font-size: 0.95rem;
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 1fr;
    gap: 2.5rem;
  }
  .footer-title {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 2px solid rgba(244, 124, 32, 0.4);
    padding-bottom: 0.4rem;
    display: inline-block;
  }
  .footer-summary {
    line-height: 1.6;
    margin-bottom: 1rem;
    color: #cbd5e1;
    font-size: 0.95rem;
  }
  .company-identity {
    font-size: 0.875rem;
    color: #cbd5e1;
    line-height: 1.55;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .identity-item {
    margin: 0;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-link {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s, padding-left 0.2s;
    font-size: 0.9rem;
  }
  .footer-link:hover {
    color: #ffffff;
    padding-left: 4px;
  }
  .contact-item {
    margin: 0 0 0.85rem;
    line-height: 1.5;
    font-size: 0.9rem;
  }
  .footer-cta-box {
    margin-top: 1.25rem;
  }
  .footer-btn {
    display: inline-block;
    background-color: #F47C20;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.55rem 1.1rem;
    border-radius: 4px;
    transition: background-color 0.2s;
  }
  .footer-btn:hover {
    background-color: #e06912;
  }
  .disclaimer-container {
    background-color: #07172c;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem 1.25rem;
  }
  .disclaimer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .copyright-text {
    font-size: 0.825rem;
    color: #94a3b8;
    margin: 0;
  }
  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
