---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FaqSection from '../../components/FaqSection.astro';
import LeadBlock from '../../components/LeadBlock.astro';
import { TARGET_SITES, CONTACT_INFO, SITE_INFO, COMPANY_INFO } from '../../config';

const title = 'Konsultasi K3 Gratis untuk Perusahaan Indonesia';
const description = 'Layanan sesi konsultasi K3 gratis bersama tim ahli. Dapatkan evaluasi gap analisis kepatuhan regulasi, audit SMK3, dan panduan SMKK awal.';
const canonicalPath = '/konsultasi-gratis/';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Konsultasi Gratis', url: '/konsultasi-gratis/' }
];

const tocItems = [
  { id: 'tentang-kami', title: 'Tentang Kami: Identitas Perusahaan' },
  { id: 'apa-yang-didapat-sesi-gratis', title: 'Fasilitas yang Anda Peroleh dalam Sesi Konsultasi Gratis' },
  { id: 'alur-proses-konsultasi', title: 'Alur 4 Langkah Pelaksanaan Konsultasi K3' },
  { id: 'contoh-studi-kasus-klien', title: 'Studi Kasus Pemecahan Masalah K3 Perusahaan Klien' },
  { id: 'siapa-yang-tepat-mengikuti', title: 'Profil Perusahaan yang Membutuhkan Sesi Ini' },
  { id: 'komitmen-independensi', title: 'Kode Etik, Kerahasiaan Data (NDA), dan Independensi' },
  { id: 'formulir-pendaftaran-sesi', title: 'Pendaftaran Konsultasi Cepat via WhatsApp dan Formulir' },
  { id: 'faq-section', title: 'Pertanyaan Umum Sesi Konsultasi Gratis' }
];

const faqItems = [
  {
    question: 'Apakah sesi konsultasi K3 gratis ini benar-benar tanpa biaya tersembunyi?',
    answer: 'Ya, 100% bebas biaya. Sesi konsultasi diagnostik awal selama 45-60 menit ini kami berikan secara gratis untuk membantu manajemen memahami posisi kepatuhan regulasi perusahaan dan menentukan roadmap keselamatan yang paling efisien.'
  },
  {
    question: 'Apakah konsultasi dilakukan secara tatap muka (luring) atau daring (online)?',
    answer: 'Sesi konsultasi awal umumnya diselenggarakan secara daring melalui video conference (Google Meet / Zoom) atau panggilan telepon terarah. Untuk peninjauan fasilitas fisik (walkthrough audit), kunjungan luring dapat dijadwalkan sesuai kesepakatan.'
  },
  {
    question: 'Dokumen apa yang sebaiknya disiapkan sebelum sesi konsultasi dimulai?',
    answer: 'Untuk memaksimalkan efektivitas sesi, Anda disarankan menyiapkan profil umum perusahaan, jumlah total karyawan, daftar perizinan K3 eksisting (jika ada), sertifikat riksa uji mesin, dan salinan Nota Pemeriksaan Disnaker jika pernah menerima teguran.'
  },
  {
    question: 'Apakah data operasional perusahaan saya dijamin kerahasiaannya?',
    answer: 'Kami memegang teguh etika profesional konsultan. Seluruh data ketenagakerjaan, foto bengkel, laporan insiden, dan rahasia dagang yang dibagikan selama sesi konsultasi dilindungi oleh klausul kerahasiaan ketat (Non-Disclosure Agreement).'
  },
  {
    question: 'Setelah sesi gratis selesai, apakah perusahaan wajib mengontrak jasa lanjutan?',
    answer: 'Sama sekali tidak ada kewajiban. Anda bebas menggunakan ringkasan rekomendasi (action plan) yang kami berikan untuk ditindaklanjuti secara mandiri bersama tim internal perusahaan Anda.'
  }
];
const lastUpdated = '2026-11-10';
const headline = 'Layanan Sesi Konsultasi K3 Gratis untuk Perusahaan';
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  lastUpdated={lastUpdated}
  headline={headline}
>
  <article class="article-body">
    <header class="article-header">
      <h1>{headline}</h1>
      <div class="article-meta">
        <span>Kategori: Konsultasi & Layanan Terbuka</span>
        <span>Diperbarui: 10 November 2026</span>
        <span>Waktu Baca: 12 Menit</span>
      </div>
    </header>

    <p class="lead-paragraph">
      Menghadapi kompleksitas regulasi ketenagakerjaan, persyaratan audit SMK3, atau persiapan berkas tender konstruksi sering kali membingungkan manajemen perusahaan. Melalui program <strong>konsultasi k3 gratis</strong>, kami membuka kesempatan diskusi teknis langsung bersama konsultan kami guna mendiagnosis status kepatuhan fasilitas kerja Anda tanpa komitmen finansial di muka.
    </p>

    <TableOfContents items={tocItems} />

    <section id="tentang-kami">
      <h2>Tentang Kami</h2>
      <p>
        <strong>{SITE_INFO.name}</strong> dikelola secara sah oleh badan hukum <strong>{COMPANY_INFO.legalName}</strong> yang beralamat kantor di {COMPANY_INFO.address}. Badan usaha ini beroperasi di bidang konsultasi teknis keselamatan dan kesehatan kerja, pendampingan sertifikasi Sistem Manajemen K3 (SMK3) sesuai Peraturan Pemerintah Nomor 50 Tahun 2012, implementasi Sistem Manajemen Keselamatan Konstruksi (SMKK) berdasarkan Peraturan Menteri PUPR Nomor 10 Tahun 2021, perumusan dokumen Hazard Identification Risk Assessment and Determining Control (HIRADC), dan pembentukan Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3).
      </p>
      <p>
        Sebagai penyedia <a href="/">layanan komprehensif konsultan K3</a> di Indonesia, ruang lingkup kegiatan difokuskan pada analisis kesenjangan regulasi (gap analysis), bimbingan penyusunan Prosedur Operasional Standar (SOP) dan Instruksi Kerja (IK), simulasi audit internal, serta pembinaan kepatuhan teknis lingkungan kerja fisik dan kimia.
      </p>
    </section>

    <section id="apa-yang-didapat-sesi-gratis">
      <h2>Fasilitas yang Anda Peroleh dalam Sesi Konsultasi Gratis</h2>
      <p>
        Program konsultasi diagnostik gratis ini dirancang secara terstruktur selama 45 hingga 60 menit. Kami menyajikan telaah terhadap kondisi riil organisasi Anda:
      </p>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Output Konsultasi</th>
              <th>Muatan Informasi yang Diberikan</th>
              <th>Manfaat bagi Manajemen</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Diagnostic Gap Analysis Singkat</strong></td>
              <td>Pemetaan kesiapan sistem eksisting terhadap 64, 122, atau 166 kriteria PP No. 50 Tahun 2012.</td>
              <td>Mengetahui secara transparan kekurangan dokumen dan fasilitas fisik sebelum audit eksternal.</td>
            </tr>
            <tr>
              <td><strong>Klarifikasi Kewajiban Regulasi</strong></td>
              <td>Analisis apakah perusahaan Anda tergolong wajib audit SMK3, wajib P2K3, atau wajib SMKK konstruksi.</td>
              <td>Menghindarkan perusahaan dari pemborosan mengurus sertifikasi yang tidak relevan dengan skala bisnis.</td>
            </tr>
            <tr>
              <td><strong>Simulasi Estimasi Anggaran</strong></td>
              <td>Perkiraan biaya jasa pendampingan, PNBP lembaga audit, dan biaya uji riksa alat kerja.</td>
              <td>Memperoleh kepastian angka anggaran berdasarkan <a href="/biaya-konsultan-k3/">rincian skema biaya jasa konsultan K3</a> yang transparan.</td>
            </tr>
            <tr>
              <td><strong>Penyusunan Roadmap Kepatuhan</strong></td>
              <td>Jadwal kerja kronologis (timeline) tahapan implementasi dari bulan pertama hingga sertifikat terbit.</td>
              <td>Memberikan kepastian tenggat waktu kepada dewan direksi dan panitia tender proyek.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        Sesi ini sangat berguna bagi pimpinan operasional yang tengah merencanakan <a href="/audit-smk3/">bimbingan persiapan audit SMK3 perusahaan kecil</a> agar terhindar dari kesalahan langkah awal yang merugikan.
      </p>
      <p>
        Dalam sesi ini, konsultan kami juga akan meninjau status perizinan alat berat dan pesawat uap/bejana tekan yang Anda miliki. Sering kali pengusaha tidak menyadari bahwa kompresor angin kecil atau genset cadangan berkapasitas di atas 100 kVA memerlukan pemeriksaan berkala dari dinas tenaga kerja. Identifikasi dini terhadap peralatan berizin ini dapat menyelamatkan perusahaan dari ancaman denda mendadak saat inspeksi lapangan pemerintah berlangsung.
      </p>
    </section>

    <section id="alur-proses-konsultasi">
      <h2>Alur 4 Langkah Pelaksanaan Konsultasi K3</h2>
      <p>
        Untuk menjaga kualitas diskusi dan efektivitas waktu kerja Anda, sesi konsultasi diselenggarakan melalui alur 4 langkah terarah:
      </p>
      <ol>
        <li>
          <strong>Pengisian Formulir Permintaan / Kontak WhatsApp:</strong> Anda mengirimkan data singkat perihal nama perusahaan, sektor usaha, jumlah pekerja, dan kendala spesifik yang dihadapi melalui formulir di halaman ini atau tautan WhatsApp resmi.
        </li>
        <li>
          <strong>Pra-Review Profil oleh Tim Teknis:</strong> Tim konsultan kami meneliti karakteristik industri Anda, peraturan perundangan sektoral yang relevan, dan riwayat risiko umum pada bidang usaha terkait secara menyeluruh.
        </li>
        <li>
          <strong>Pelaksanaan Sesi Diskusi 1-on-1 (Online / Tatap Muka):</strong> Diskusi interaktif langsung via Google Meet / Zoom dipimpin oleh konsultan berlisensi SKP Kemnaker. Kami membedah masalah Anda, memberikan jawaban atas pertanyaan regulasi, dan memaparkan solusi teknis terbaik.
        </li>
        <li>
          <strong>Penyerahan Ringkasan Rekomendasi (Action Plan):</strong> Pasca sesi, kami mengirimkan dokumen ringkasan rekomendasi tindakan awal dan estimasi rencana kerja sebagai bahan pertimbangan pengambil keputusan di perusahaan Anda.
        </li>
      </ol>
      <p>
        Bagi pelaku kontraktor yang membutuhkan percepatan pemenuhan lelang tender fisik, kami juga mengulas strategi pemenuhan <a href="/smkk-konstruksi/">kebutuhan tender SMKK konstruksi kontraktor</a> dalam sesi ini.
      </p>
    </section>

    <section id="contoh-studi-kasus-klien">
      <h2>Studi Kasus Pemecahan Masalah K3 Perusahaan Klien</h2>
      <p>
        Untuk memberikan gambaran nyata mengenai manfaat langsung dari sesi pendampingan awal ini, berikut adalah dua contoh kasus riil yang ditangani:
      </p>
      <p>
        <strong>Kasus 1: Kontraktor MEP Menghadapi Deadline Tender 3 Minggu</strong><br />
        Sebuah perusahaan instalasi kelistrikan di Jakarta Barat memenangkan lelang pekerjaan mekanikal-elektrikal di gedung bertingkat swasta. Tiga minggu sebelum penandatanganan kontrak kerja sama, pemilik proyek mensyaratkan penyedia jasa melampirkan dokumen Manual SMK3 terverifikasi dan dokumen Rencana Keselamatan Konstruksi (RKK) sesuai format Permen PUPR 10/2021. Manajemen kontraktor memerlukan pendampingan segera karena belum pernah memiliki dokumen keselamatan tertulis.
      </p>
      <p>
        Melalui sesi konsultasi kilat, konsultan kami memetakan aktivitas kritis pekerjaan kelistrikan (pekerjaan tegangan menengah, isolasi LOTO, bekerja di atas perancah), menyusun 14 SOP keselamatan spesifik, dan merumuskan dokumen RKK komprehensif. Hasilnya, dokumen kontraktor disetujui tanpa catatan oleh tim konsultan manajemen konstruksi dan kontrak kerja senilai miliaran rupiah berhasil diamankan.
      </p>
      <p>
        <strong>Kasus 2: Pabrik Plastik Mengatasi Nota Pemeriksaan Disnaker</strong><br />
        Pabrik manufaktur injection moulding di Tangerang dengan 140 tenaga kerja menerima Nota Pemeriksaan I dari pengawas ketenagakerjaan provinsi karena belum memiliki struktur P2K3 dan belum pernah melakukan pengujian lingkungan kerja fisik (kebisingan dan iklim panas). Pengawas memberikan tenggat waktu 30 hari untuk perbaikan.
      </p>
      <p>
        Dalam sesi konsultasi terarah, kami memandu pembentukan komite bipartit P2K3, menyusun berkas pengesahan ke dinas tenaga kerja, dan mengoordinasikan pengukuran lingkungan kerja bersama laboratorium terakreditasi KAN. Dalam waktu 18 hari kerja, Surat Keputusan Pengesahan P2K3 resmi terbit dan nota pemeriksaan berhasil ditutup secara memuaskan oleh pengawas.
      </p>
    </section>

    <section id="siapa-yang-tepat-mengikuti">
      <h2>Profil Perusahaan yang Membutuhkan Sesi Ini</h2>
      <p>
        Sesi konsultasi K3 ini sangat tepat dimanfaatkan oleh penanggung jawab keselamatan dan manajemen kunci, antara lain:
      </p>
      <ul>
        <li>
          <strong>Direktur Utama / Pemilik Usaha:</strong> Yang ingin memastikan legalitas tempat kerja terlindungi dari sanksi keselamatan kerja tanpa harus membebani neraca keuangan perusahaan.
        </li>
        <li>
          <strong>HSE Officer / HRD Manager:</strong> Yang ditugaskan membentuk sistem keselamatan dari dasar dan membutuhkan panduan urutan kerja yang sistematis sesuai regulasi.
        </li>
        <li>
          <strong>Project Manager Kontraktor:</strong> Yang sedang mempersiapkan dokumen Rencana Keselamatan Konstruksi (RKK) untuk persyaratan tender instansi pemerintah (PUPR/BUMN).
        </li>
        <li>
          <strong>General Affair / Manajer Pabrik:</strong> Yang sedang menghadapi temuan Nota Pemeriksaan dari Pengawas Ketenagakerjaan Dinas Tenaga Kerja setempat dan memerlukan rencana tindakan perbaikan segera.
        </li>
      </ul>
      <p>
        Dalam sesi ini, Anda juga dapat menanyakan tata cara penyusunan dan pengarsipan <a href="/dokumen-smk3/">pemeriksaan berkas dokumen SMK3 wajib</a> untuk menjamin keabsahan seluruh berkas legalitas.
      </p>
    </section>

    <section id="komitmen-independensi">
      <h2>Kode Etik, Kerahasiaan Data (NDA), dan Independensi</h2>
      <p>
        Kami menjunjung tinggi integritas keprofesian konsultan manajemen:
      </p>
      <p>
        <strong>Kerahasiaan Ketat (Non-Disclosure Guarantee):</strong> Seluruh data operasional, dokumen rancangan mesin, daftar karyawan, maupun catatan insiden yang Anda sampaikan dalam sesi konsultasi dijamin kerahasiaannya dan tidak akan pernah dibagikan kepada pihak ketiga mana pun tanpa persetujuan tertulis manajemen Anda.
      </p>
      <p>
        <strong>Independensi & Objektivitas:</strong> KonsultanK3 adalah badan konsultan independen di bawah naungan {COMPANY_INFO.legalName}. Kami bukan lembaga audit sertifikasi resmi dan bukan instansi penegak hukum pemerintah. Kami berada di sisi klien untuk mendampingi, mengedukasi, dan memperkuat kesiapan operasional Anda sebelum menghadapi audit pihak luar.
      </p>
      <p>
        Untuk kebutuhan peningkatan kapasitas sertifikasi personil internal seperti pelatihan juru ukur lingkungan kerja, petugas kebakaran, atau Ahli K3 Umum, perusahaan dapat merujuk ke <a href="https://pelatihan-k3.co.id" target="_blank" rel="noopener noreferrer">portal Pelatihan K3</a> resmi berizin Kementerian Ketenagakerjaan.
      </p>
    </section>

    <section id="formulir-pendaftaran-sesi">
      <h2>Pendaftaran Konsultasi Cepat via WhatsApp dan Formulir</h2>
      <p>
        Pencegahan risiko keselamatan kerja lebih baik dilakukan sedini mungkin sebelum terjadi insiden atau teguran dari pihak berwenang. Dapatkan kejelasan arah mitigasi risiko dan efisiensi anggaran sekarang juga.
      </p>
      <p>
        Anda dapat menghubungi tim layanan kami secara langsung melalui:
      </p>
      <ul>
        <li><strong>WhatsApp Cepat:</strong> <a href={CONTACT_INFO.whatsappUrl}>{CONTACT_INFO.whatsappNumber}</a></li>
      </ul>
    </section>

    <LeadBlock 
      title="Daftar Sesi Konsultasi K3 Gratis Hari Ini"
      subtitle="Isi formulir di bawah ini atau klik tombol WhatsApp untuk terhubung langsung dengan konsultan keselamatan kerja kami."
      defaultNeed="Sesi Konsultasi K3 Gratis"
    />

    <FaqSection items={faqItems} />
  </article>
</Layout>

<style>
  .article-header {
    margin-bottom: 2rem;
  }
  .lead-paragraph {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #1e293b;
    margin-bottom: 2rem;
    border-left: 4px solid #0B2545;
    padding-left: 1rem;
    font-weight: 450;
  }
</style>
