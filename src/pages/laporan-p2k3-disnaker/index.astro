            </tr>
            <tr>
              <td>Kasus Pertolongan Pertama (<em>First Aid Injury / P3K</em>)</td>
              <td>1</td>
              <td>0</td>
              <td>0</td>
              <td>1 Kasus (Luka gores ringan)</td>
            </tr>
            <tr>
              <td>Kasus Perawatan Medis Tanpa Hilang Hari Kerja (<em>MTC</em>)</td>
              <td>0</td>
              <td>0</td>
              <td>0</td>
              <td>0 (Nihil)</td>
            </tr>
            <tr>
              <td>Kasus Kecelakaan Hilang Hari Kerja (<em>Lost Time Injury / LTI</em>)</td>
              <td>0</td>
              <td>0</td>
              <td>0</td>
              <td><strong>0 (Nihil / Zero Accident)</strong></td>
            </tr>
            <tr>
              <td>Kasus Kematian (<em>Fatality</em>) &amp; Penyakit Akibat Kerja (PAK)</td>
              <td>0</td>
