const faqItems = [
  {
    question: 'Apa perbedaan antara standar rambu K3 ISO 7010 dengan ANSI Z535?',
    answer: 'Standar ISO 7010 mengutamakan komunikasi visual berbasis piktogram (simbol gambar universal) dan bentuk geometris (lingkaran, segitiga, bujursangkar) agar langsung dipahami oleh pekerja lintas bahasa tanpa perlu membaca teks panjang. Sedangkan standar Amerika ANSI Z535 menonjolkan penggunaan panel kata sinyal (Signal Words) di bagian atas rambu seperti DANGER (Merah), WARNING (Oranye), CAUTION (Kuning), dan NOTICE (Biru) yang disertai teks penjelasan bahaya.'
  },
  {
    question: 'Mengapa rambu jalur evakuasi dan titik kumpul berwarna hijau, sedangkan rambu APAR berwarna merah?',
    answer: 'Dalam psikologi ergonomi visual dan standar ISO 3864 / ISO 7010, warna hijau melambangkan kondisi aman (safe condition), kebebasan akses penyelamatan diri, dan pertolongan pertama (P3K). Sebaliknya, warna merah persegi khusus didedikasikan untuk peralatan pemadam kebakaran (APAR, hidran, alarm titik panggil manual) agar kontras dan langsung mudah ditemukan saat terjadi kobaran api.'
  },
  {
    question: 'Di mana posisi Rambu K3 dalam 5 Hierarki Pengendalian Risiko?',
